    {
      "id": "zone-algebra",
      "title": "존 밖 가중의 대수와 운영 정의",
      "queries": [
        {
          "id": "formula-source",
          "source": {
            "label": "요청 브랜치의 산식과 운영 소스",
            "files": [
              {
                "label": "gates.md"
              },
              {
                "label": "zb_neutral_za.py"
              },
              {
                "label": "zd_strike_weight.py"
              },
              {
                "label": "zone_decision.py"
              }
            ],
            "caveats": [
              "이진 존 근사와 연속 판정 확률은 서로 다른 대수식을 갖는다."
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "직접 계산 결과",
                "detail": "이진 중립 항등식, SA 혼합식, 연속 분해식의 assert가 통과했다. 연속값 반례에서 c=1은 A>B, c=3은 A<B였다."
              }
            ]
          },
          "methods": [
            {
              "language": "calculation",
              "code": "N0 = 100 E[(r-m)z]\nNc = 100 [((1+c)/2) E[(r-m)z] + ((1-c)/2) E[(r-m)|z|]] / E_league[w]"
            }
          ]
        }
      ]
    },
    {
